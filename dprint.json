{
  "json": {},
  "markdown": {
    "lineWidth": 80,
    "textWrap": "always",
    "wrapCodeSpans": false
  },
  "toml": {},
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "command": "rustfmt --edition 2024",
        "exts": ["rs"],
        "cacheKeyFiles": ["rust-toolchain.toml"]
      },
      {
        "command": "clang-format --assume-filename={{file_path}}",
        "exts": ["c", "h"]
      }
    ]
  },
  "excludes": ["**/*-lock.json"],
  "plugins": [
    "npm:@dprint/json@0.26.0",
    "npm:@dprint/markdown@0.29.0",
    "npm:@dprint/toml@0.10.0",
    "npm:@dprint/exec@0.9.0/plugin.json@d4f708dc00798b51013ca4e7c26a86656bfb31e7255cdcde28a487f86813e34d"
  ]
}
