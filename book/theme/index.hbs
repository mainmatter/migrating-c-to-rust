                                <span class="screenreader">Bluesky</span>
                            </a>
                            <a class="social__link" href="https://twitter.com/mainmatter/" target="_blank" rel="noopener noreferrer" aria-describedby="external-new-window-message">
                                <span class="social__icon">
                                    <svg focusable="false" aria-hidden="true" width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M20 0C31.0457 0 40 8.95431 40 20C40 31.0457 31.0457 40 20 40C8.95431 40 0 31.0457 0 20C0 8.95431 8.95431 0 20 0ZM10 11.25L17.5615 20.8203L10.3945 28.75H13.4639L18.9951 22.6309L23.8291 28.75H30L22.1172 18.6631L28.8174 11.25H25.75L20.6973 16.8418L16.3291 11.25H10ZM15.4033 12.9336L26.375 26.9736H24.6748L13.5811 12.9336H15.4033Z" fill="currentColor"></path></svg>
